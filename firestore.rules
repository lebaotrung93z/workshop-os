rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function sessionPath(sessionId) {
      return /databases/$(database)/documents/sessions/$(sessionId);
    }

    function keepsHostToken(sessionId) {
      return request.resource.data.hostToken == resource.data.hostToken;
    }

    function isParticipantCountBump() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantCount'])
        && request.resource.data.participantCount is int
        && request.resource.data.participantCount == resource.data.participantCount + 1;
    }

    function participantDoc(sessionId, participantId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId)/participants/$(participantId));
    }

    function isParticipantWrite(sessionId) {
      return request.resource.data.participantId is string
        && request.resource.data.joinToken is string
        && participantDoc(sessionId, request.resource.data.participantId).data.joinToken
          == request.resource.data.joinToken;
    }

    function isEntryOwner(sessionId) {
      return resource.data.participantId is string
        && resource.data.joinToken is string
        && request.resource.data.participantId == resource.data.participantId
        && request.resource.data.joinToken == resource.data.joinToken
        && participantDoc(sessionId, resource.data.participantId).data.joinToken
          == resource.data.joinToken;
    }

    function isActionOwner(sessionId) {
      return resource.data.participantId is string
        && resource.data.joinToken is string
        && request.resource.data.participantId == resource.data.participantId
        && request.resource.data.joinToken == resource.data.joinToken
        && participantDoc(sessionId, resource.data.participantId).data.joinToken
          == resource.data.joinToken;
    }

    function isHost(sessionId) {
      return request.resource.data.hostToken == get(sessionPath(sessionId)).data.hostToken;
    }

    match /templates/{templateId} {
      allow read: if true;
      // Create + seedRevision bumps for built-in templates (client-side ensureTemplates).
      allow create, update: if true;
      allow delete: if false;
    }

    match /sessionCodes/{code} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['sessionId'])
        && request.resource.data.sessionId is string;
      allow update, delete: if false;
    }

    match /sessions/{sessionId} {
      allow read: if true;
      allow create: if request.resource.data.hostToken is string
        && request.resource.data.code is string
        && request.resource.data.status == 'LOBBY'
        && request.resource.data.steps is list;
      allow update: if keepsHostToken(sessionId) || isParticipantCountBump();
      allow delete: if false;

      match /participants/{participantId} {
        allow read: if true;
        allow create: if request.resource.data.joinToken is string
          && request.resource.data.displayName is string
          && request.resource.data.uid == participantId;
        allow update, delete: if false;
      }

      match /entries/{entryId} {
        allow read: if true;
        allow create: if (
            isParticipantWrite(sessionId)
            || (
              isHost(sessionId)
              && request.resource.data.kind == 'objective'
            )
          )
          && request.resource.data.hidden == false
          && request.resource.data.content is string
          && request.resource.data.stepId is string;
        allow update: if
          // Host soft-hide
          (
            isHost(sessionId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden', 'hostToken'])
          )
          // Owner edits content / parent / group
          || (
            isEntryOwner(sessionId)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['content', 'parentId', 'groupId', 'participantId', 'joinToken', 'updatedAt'])
            && request.resource.data.content is string
            && request.resource.data.hidden == resource.data.hidden
          )
          // Owner soft-deletes own entry
          || (
            isEntryOwner(sessionId)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['hidden', 'participantId', 'joinToken', 'updatedAt'])
            && request.resource.data.hidden == true
          )
          // Host edits objective text
          || (
            isHost(sessionId)
            && resource.data.kind == 'objective'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['content', 'hostToken', 'updatedAt'])
            && request.resource.data.content is string
          );
        allow delete: if false;
      }

      match /votes/{voteId} {
        allow read: if true;
        allow create: if isParticipantWrite(sessionId)
          && voteId == request.resource.data.entryId + '_' + request.resource.data.participantId;
        // Participant may remove their own vote (unvote). joinToken is already on the vote doc.
        allow delete: if resource.data.participantId is string
          && resource.data.joinToken is string
          && voteId == resource.data.entryId + '_' + resource.data.participantId
          && participantDoc(sessionId, resource.data.participantId).data.joinToken
            == resource.data.joinToken;
        allow update: if false;
      }

      match /actions/{actionId} {
        allow read: if true;
        allow create: if isParticipantWrite(sessionId)
          || isHost(sessionId);
        allow update: if
          isHost(sessionId)
          || (
            isActionOwner(sessionId)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'action', 'owner', 'dueDate', 'sourceEntryId', 'sourceLabel',
                'participantId', 'joinToken', 'updatedAt', 'hidden'
              ])
          );
        allow delete: if false;
      }

      match /summary/{docId} {
        allow read: if true;
        allow create, update: if request.resource.data.hostToken
          == get(sessionPath(sessionId)).data.hostToken;
        allow delete: if false;
      }
    }
  }
}
